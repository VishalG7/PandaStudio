# Python
__pycache__/
*.py[cod]
*$py.class
*.env
.venv/
env/
venv/

# PyInstaller build cache (keep dist/ for zero-install distribution)
build/
*.manifest
*.spec.bak
dist/backups/

# Backups and personal user data (never commit personal backups or images)
backups/*
!backups/.gitkeep
!backups/logs/
backups/logs/*
!backups/logs/.gitkeep
*.log

# Audio generated files (never commit personal generated audio)
audio/*
!audio/.gitkeep

# Operating System & IDE files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.vscode/
.idea/
